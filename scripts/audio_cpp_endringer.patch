+void Drama3Generator::pin_experts(const std::string & path) {
+    std::ifstream in(path);
+    if (!in) throw std::runtime_error("cannot open pin experts file: " + path);
+    std::vector<std::vector<int32_t>> per_layer;
+    std::string line;
+    while (std::getline(in, line)) {
+        if (line.empty() || line[0] == '#') continue;
+        std::istringstream fields(line);
+        int64_t layer = -1;
+        int64_t expert = -1;
+        if (!(fields >> layer >> expert)) continue;
+        if (layer < 0 || expert < 0) continue;
+        if (static_cast<size_t>(layer) >= per_layer.size()) per_layer.resize(static_cast<size_t>(layer) + 1);
+        per_layer[static_cast<size_t>(layer)].push_back(static_cast<int32_t>(expert));
+    }
+    backbone_->pin_experts(per_layer);
+    size_t total = 0;
+    for (const auto & layer : per_layer) total += layer.size();
