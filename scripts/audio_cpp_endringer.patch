+// (21.5 frames = 1 s). 0 = off.
+struct PauseClamp {
+    std::unordered_set<int32_t> codes;
+    int64_t max_pause = 0;
+    // Length guard: a pause after end_ratio x the text's expected frames ends the
+    // take instead of forcing speech; cap_ratio x expected ends it regardless.
+    double end_ratio = 2.0;
+    double cap_ratio = 3.0;
