+// Drama 3 routing statistics. When enabled, the router's chosen expert ids
+// and their softmax probabilities are accumulated per layer, so a caller can
+// see which experts a language actually exercises. Used to pick the experts
+// worth keeping when pruning a checkpoint.
+struct Drama3RoutingStats {
+    bool enabled = false;
+    std::mutex mutex;
+    std::vector<std::vector<int64_t>> counts;   // per layer: times chosen
+    std::vector<std::vector<double>> mass;      // per layer: summed probability
+    std::vector<int64_t> steps;                 // per layer: tokens seen
+};
+
+Drama3RoutingStats & routing_stats() {
+    static Drama3RoutingStats stats;
+    return stats;
+}
+
+void routing_stats_reset(int64_t layers, int64_t experts) {
+    auto & s = routing_stats();
+    std::lock_guard<std::mutex> lock(s.mutex);
+    s.counts.assign(static_cast<size_t>(layers), std::vector<int64_t>(static_cast<size_t>(experts), 0));
+    s.mass.assign(static_cast<size_t>(layers), std::vector<double>(static_cast<size_t>(experts), 0.0));
+    s.steps.assign(static_cast<size_t>(layers), 0);
+    s.enabled = true;
+}
+
+// Accumulate one layer's routing decision. Reads the top-k ids and the
+// matching probabilities back from the backend so the numbers are the real
+// ones the sampler used.
+void routing_stats_record(int64_t layer,
+                           ggml_tensor * expert_ids,
+                           ggml_tensor * probabilities,
+                           int64_t steps,
+                           int64_t experts,
+                           int64_t top_k) {
+    auto & s = routing_stats();
+    if (!s.enabled) return;
+    if (layer < 0 || static_cast<size_t>(layer) >= s.counts.size()) return;
+    std::lock_guard<std::mutex> lock(s.mutex);
+
+    const size_t id_count = static_cast<size_t>(steps * top_k);
+    std::vector<float> ids(id_count);
+    ggml_backend_tensor_get(expert_ids, ids.data(), 0, id_count * sizeof(float));
+
+    // probabilities is (experts, steps); read the selected rows for each step.
+    std::vector<float> probs(static_cast<size_t>(experts * steps));
+    ggml_backend_tensor_get(probabilities, probs.data(), 0, probs.size() * sizeof(float));
+
+    for (size_t step = 0; step < static_cast<size_t>(steps); ++step) {
+        for (size_t k = 0; k < static_cast<size_t>(top_k); ++k) {
+            const int64_t expert = static_cast<int64_t>(ids[step * static_cast<size_t>(top_k) + k]);
+            if (expert < 0 || expert >= experts) continue;
+            s.counts[static_cast<size_t>(layer)][static_cast<size_t>(expert)] += 1;
+            s.mass[static_cast<size_t>(layer)][static_cast<size_t>(expert)] +=
+                probs[step * static_cast<size_t>(experts) + static_cast<size_t>(expert)];
+        }
+        s.steps[static_cast<size_t>(layer)] += 1;
+    }
+}
